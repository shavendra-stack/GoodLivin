NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Legacy name supported for older Supabase projects.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to true to run the UI with the clearly labelled local demo session.
# Keep false in any environment connected to real data.
NEXT_PUBLIC_DEMO_MODE=false

# Optional server-only key for operational scripts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Vercel Cron secret. Use a long random value and do not expose it in client code.
CRON_SECRET=

# Legacy external-scheduler secret retained for compatibility with POST callers.
# Prefer CRON_SECRET for Vercel Cron.
STAGE8_ALERT_JOB_SECRET=
